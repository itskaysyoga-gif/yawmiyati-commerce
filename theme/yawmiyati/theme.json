{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{
					"slug": "ivory",
					"name": "Ivory (page)",
					"color": "#FAFBF9"
				},
				{
					"slug": "paper",
					"name": "White (surfaces)",
					"color": "#FFFFFF"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1D2922"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#536158"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "#DCE3DC"
				},
				{
					"slug": "berry",
					"name": "Berry (actions)",
					"color": "#7B2D58"
				},
				{
					"slug": "berry-tint",
					"name": "Berry tint",
					"color": "#F6ECF1"
				},
				{
					"slug": "blush",
					"name": "Blush",
					"color": "#F5F2EC"
				},
				{
					"slug": "sage",
					"name": "Sage",
					"color": "#E5EEE3"
				},
				{
					"slug": "sage-ink",
					"name": "Sage ink",
					"color": "#3F5B45"
				},
				{
					"slug": "diary",
					"name": "Diary paper",
					"color": "#F5F7F2"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#B42318"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%"
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "readex",
					"name": "Readex Pro",
					"fontFamily": "'Readex Pro', system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Readex Pro",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/readex-pro-arabic-400-normal.woff2"
							],
							"unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC"
						},
						{
							"fontFamily": "Readex Pro",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/readex-pro-arabic-600-normal.woff2"
							],
							"unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC"
						},
						{
							"fontFamily": "Readex Pro",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/readex-pro-latin-400-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Readex Pro",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/readex-pro-latin-600-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "ruqaa",
					"name": "Aref Ruqaa",
					"fontFamily": "'Aref Ruqaa', serif",
					"fontFace": [
						{
							"fontFamily": "Aref Ruqaa",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/aref-ruqaa-arabic-400-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "14px"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "16px"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "20px"
				},
				{
					"slug": "x-large",
					"name": "Title",
					"size": "clamp(24px, 3vw, 34px)"
				}
			]
		},
		"useRootPaddingAwareAlignments": false
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--readex)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "0px",
				"right": "0px",
				"top": "0px",
				"bottom": "0px"
			},
			"blockGap": "0px"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--berry)"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
