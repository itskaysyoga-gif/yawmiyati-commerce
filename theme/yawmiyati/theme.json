        {
          "slug": "ruqaa",
          "name": "Aref Ruqaa",
          "fontFamily": "'Aref Ruqaa', serif",
          "fontFace": [
            {
              "fontFamily": "Aref Ruqaa",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/aref-ruqaa-arabic-400-normal.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "16px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "20px"
        },
        {
          "slug": "x-large",
          "name": "Title",
          "size": "clamp(24px, 3vw, 34px)"
        }
      ]
    },
    "useRootPaddingAwareAlignments": false
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--readex)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": {
        "left": "0px",
        "right": "0px",
        "top": "0px",
        "bottom": "0px"
      },
      "blockGap": "0px"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--nila)"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.35"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}