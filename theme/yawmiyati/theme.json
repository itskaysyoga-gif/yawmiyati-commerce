{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#FFFFFF"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1F1D1E"
        },
        {
          "slug": "nila",
          "name": "Nila indigo",
          "color": "#2B3192"
        },
        {
          "slug": "nila-tint",
          "name": "Nila tint",
          "color": "#EEF0FA"
        },
        {
          "slug": "rule",
          "name": "Rule",
          "color": "#E7E5E1"
        },
        {
          "slug": "muted",
          "name": "Muted text",
          "color": "#5E5A57"
        },
        {
          "slug": "diary",
          "name": "Diary paper",
          "color": "#FBFAF7"
        },
        {
          "slug": "error",
          "name": "Error",
          "color": "#B42318"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "readex",
          "name": "Readex Pro",
          "fontFamily": "'Readex Pro', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Readex Pro",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/readex-pro-arabic-400-normal.woff2"
              ],
              "unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC"
